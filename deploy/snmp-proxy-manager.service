# systemd unit — snmp-proxy manager instance (manager-side proxy).
# Install: cp deploy/snmp-proxy-manager.service /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable --now snmp-proxy-manager
#
# The instance reads its YAML config from /etc/snmp-proxy/manager.yaml
# (see configs/manager-*.yaml for templates).

[Unit]
Description=SNMP securing proxy (manager side)
Documentation=https://github.com/GalaxyGorilla/snmp-proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/snmp-proxy manager --config /etc/snmp-proxy/manager.yaml
Restart=on-failure
RestartSec=5

# The engine boots store must persist across restarts (anti-rollback);
# StateDirectory guarantees it survives package upgrades and reboots.
StateDirectory=snmp-proxy
ConfigurationDirectory=snmp-proxy

# Hardening: the proxy needs only its UDP sockets and the engine store.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native

# CAP_NET_BIND_SERVICE allows binding privileged ports (<1024, e.g. the
# standard :161/:162) without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

User=snmp-proxy
Group=snmp-proxy

[Install]
WantedBy=multi-user.target
