# systemd unit — snmp-shield gateway instance (single-box mode).
# Install: cp deploy/snmp-shield-gateway.service /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable --now snmp-shield-gateway
#
# The gateway is a single box: it terminates SNMP security from standard
# clients/managers and relays to the legacy agent. Config from
# /etc/snmp-shield/gateway.yaml (see configs/gateway-*.yaml).

[Unit]
Description=SNMP securing proxy (gateway)
Documentation=https://github.com/GalaxyGorilla/snmp-shield
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/snmp-shield gateway --config /etc/snmp-shield/gateway.yaml
Restart=on-failure
RestartSec=5

StateDirectory=snmp-shield
ConfigurationDirectory=snmp-shield

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

User=snmp-shield
Group=snmp-shield

[Install]
WantedBy=multi-user.target
