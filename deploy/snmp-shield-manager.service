# systemd unit — snmp-shield manager instance (manager-side proxy).
# Install: cp deploy/snmp-shield-manager.service /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable --now snmp-shield-manager
#
# The instance reads its YAML config from /etc/snmp-shield/manager.yaml
# (see configs/manager-*.yaml for templates).

[Unit]
Description=SNMP securing proxy (manager side)
Documentation=https://github.com/GalaxyGorilla/snmp-shield
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
WatchdogSec=30
ExecStart=/usr/local/bin/snmp-shield manager --config /etc/snmp-shield/manager.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# The engine boots store must persist across restarts (anti-rollback);
# StateDirectory guarantees it survives package upgrades and reboots.
StateDirectory=snmp-shield
ConfigurationDirectory=snmp-shield

# Hardening: the proxy needs only its UDP sockets and the engine store.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native

# CAP_NET_BIND_SERVICE allows binding privileged ports (<1024, e.g. the
# standard :161/:162) without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

User=snmp-shield
Group=snmp-shield

[Install]
WantedBy=multi-user.target
